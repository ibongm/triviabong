rules_version = '2';

// Deploy with: firebase deploy --only firestore:rules
// (requires `firebase login` and the project already set in .firebaserc)

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Mirrors ADMIN_EMAIL in src/App.jsx. Keep these two in sync manually —
    // if the admin email ever changes, update it in both places.
    function isAdmin() {
      return isSignedIn()
        && (request.auth.token.admin == true
            || (request.auth.token.email == 'ivanm.ploce@gmail.com' && request.auth.token.email_verified == true));
    }

    // Plan B (1v1) helpers - shared by the matches/{matchId} update branches
    // below. isMatchParticipant/matchIsTerminal read `data`/`resource.data`
    // explicitly (not implicit `resource`) so they work identically whether
    // called against `resource.data` (pre-write) or a freshly-created doc.
    function isMatchParticipant(data) {
      return isSignedIn() && (data.player1Uid == request.auth.uid || data.player2Uid == request.auth.uid);
    }

    function matchIsTerminal() {
      return resource.data.status == 'match_over' || resource.data.status == 'forfeited';
    }

    // Identity/setup fields that must never change after match creation -
    // every update branch below is diff-based against this, so a malicious
    // update can't smuggle a change to who's playing, what they're playing,
    // or what the questions are alongside a legitimate-looking field change.
    function matchIdentityUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(
        ['player1Uid', 'player2Uid', 'player1DisplayName', 'player2DisplayName', 'category', 'questionIds', 'createdAt', 'inviteId']
      );
    }

    match /users/{uid} {
      // Only the owner or an admin can read a specific profile.
      allow get: if isOwner(uid) || isAdmin();
      // Only an admin can list the whole users collection (AdminPanel).
      allow list: if isAdmin();

      // Created by syncUserProfile() on first login — owner only, and it
      // can't seed itself with privileged fields.
      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && !('role' in request.resource.data)
        && (!('level' in request.resource.data) || (request.resource.data.level is int && request.resource.data.level >= 1))
        && (!('xp' in request.resource.data) || (request.resource.data.xp is int && request.resource.data.xp >= 0))
        && (!('coins' in request.resource.data) || (request.resource.data.coins is int && request.resource.data.coins >= 0));

      // Owner can update their own doc (e.g. syncUserStatsToFirestore
      // merges level/xp/coins) but can never touch `role`. Admin can
      // update anything (AdminPanel's edit form).
      allow update: if isAdmin()
        || (isOwner(uid)
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
            && (!('level' in request.resource.data) || (request.resource.data.level is int && request.resource.data.level >= 1))
            && (!('xp' in request.resource.data) || (request.resource.data.xp is int && request.resource.data.xp >= 0))
            && (!('coins' in request.resource.data) || (request.resource.data.coins is int && request.resource.data.coins >= 0))
            && (!('maxStreak' in request.resource.data) || (request.resource.data.maxStreak is int && request.resource.data.maxStreak >= 0))
            && (!('dayStreak' in request.resource.data) || (request.resource.data.dayStreak is int && request.resource.data.dayStreak >= 0))
            && (!('achievementCount' in request.resource.data) || (request.resource.data.achievementCount is int && request.resource.data.achievementCount >= 0 && request.resource.data.achievementCount <= 100))
            // playTime: running time-in-app counters (see addPlayTime),
            // incremented from useSessionTracking's 90s heartbeat so the admin
            // player list can show Danas/Tjedan/Ukupno without scanning the
            // sessions collection. Monotonic and non-negative: a client may
            // only ever add. That bounds tampering to inflation, which the
            // client also clamps per write (MAX_PLAY_TIME_DELTA_SECONDS) - the
            // same failure mode the 2026-08-22 session-flush clamp addressed.
            // Rules can't validate the delta of a nested map field, so the cap
            // on how MUCH it can grow per write lives client-side by necessity.
            && (!('playTime' in request.resource.data)
                || (request.resource.data.playTime.total is int
                    && request.resource.data.playTime.total >= 0
                    && (!('playTime' in resource.data)
                        || request.resource.data.playTime.total >= resource.data.playTime.total))));

      allow delete: if isAdmin();

      // Daily micro-missions (7-day rotating schedule, see
      // src/constants/missions.js) - one doc per Zagreb calendar date under
      // the owning user, tracking that day's 3 slot progress. Owner-only,
      // same "signed-in required" gate as Daily Challenge/sessions - there's
      // no anonymous mission tracking. dateKey format matches
      // getZagrebDateString()'s YYYY-MM-DD output.
      match /missions/{dateKey} {
        allow read, write: if isOwner(uid) && dateKey.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}');
      }

      // Private leagues (engagement plan Phase 6): the player's own index of
      // the leagues they belong to - a cache of name/emoji so the "Lige" list
      // is one small query instead of a collection-group query. Owner-only.
      // It is NOT proof of membership (the league's members/{uid} doc is);
      // the 5-leagues-per-player limit is client-enforced.
      match /leagues/{leagueId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['name', 'emoji', 'joinedAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 30
          && request.resource.data.emoji is string
          && request.resource.data.emoji.size() > 0
          && request.resource.data.emoji.size() <= 8
          && request.resource.data.joinedAt is timestamp;
      }
    }

    match /leaderboards/{categoryKey}/scores/{scoreId} {
      // Leaderboards are shown to signed-out visitors too.
      allow read: if true;

      // Scores are still client-computed (see App.jsx game logic), so this
      // only bounds the damage, it doesn't make scores trustworthy. 10000 is
      // a generous ceiling above the ~5980 max a legitimate 10-question
      // perfect run can produce (10 correct answers at the 20s question
      // timer, streak multiplier up to 2.8x, +10s joker used on the
      // highest-multiplier question).
      //
      // elapsedMs/isPerfect (added for the Rekordi "fastest perfect round"
      // board) are optional - hasOnly bounds which keys CAN exist, it
      // doesn't require them, so older writes without them still validate.
      // 200000ms is the generous ceiling for 10 questions at the 20s timer.
      allow create: if request.resource.data.keys().hasOnly(['name', 'score', 'uid', 'createdAt', 'elapsedMs', 'isPerfect'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 20
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 10000
        && request.resource.data.createdAt == request.time
        && (!('uid' in request.resource.data)
            || request.resource.data.uid == null
            || isOwner(request.resource.data.uid))
        && (!('elapsedMs' in request.resource.data)
            || (request.resource.data.elapsedMs is int
                && request.resource.data.elapsedMs >= 0
                && request.resource.data.elapsedMs <= 200000))
        && (!('isPerfect' in request.resource.data)
            || request.resource.data.isPerfect is bool);

      allow update, delete: if isAdmin();
    }

    // Deliberately public-safe summary for the Rekordi ranking boards
    // (highest level, longest streak, most trophies, longest day-streak) -
    // holds only what a public ranking needs, never the sensitive fields
    // that keep users/{uid} owner/admin-only (email, role, etc.). Synced
    // by syncPublicProfile() alongside the existing full-stats sync.
    match /publicProfiles/{uid} {
      allow read: if true;

      // Admin can also write any uid's doc, specifically so the AdminPanel
      // "backfill" action can populate this collection for existing players
      // who registered before it existed (their doc is otherwise only ever
      // created/updated by their own client, next time they sign back in).
      //
      // achievementCount's ceiling is deliberately well above the 30
      // achievements in src/constants/achievements.js. It used to be exactly
      // 30 - zero headroom - so defining a 31st achievement would have
      // started rejecting every write here, live sync included, with nothing
      // but a swallowed permission error to show for it. Mirrored by
      // MAX_ACHIEVEMENT_COUNT in src/utils/publicProfile.js; keep in sync.
      allow create, update: if (isOwner(uid) || isAdmin())
        && request.resource.data.keys().hasOnly(['displayName', 'level', 'xp', 'maxStreak', 'dayStreak', 'achievementCount', 'updatedAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 20
        && request.resource.data.level is int
        && request.resource.data.level >= 1
        && request.resource.data.xp is int
        && request.resource.data.xp >= 0
        && request.resource.data.maxStreak is int
        && request.resource.data.maxStreak >= 0
        && request.resource.data.dayStreak is int
        && request.resource.data.dayStreak >= 0
        && request.resource.data.achievementCount is int
        && request.resource.data.achievementCount >= 0
        && request.resource.data.achievementCount <= 100;

      allow delete: if isAdmin();
    }

    // Maintained aggregate for the Rekordi "fastest perfect round" board -
    // updated transactionally by maybeUpdateFastestPerfectRecord() whenever
    // a perfect round beats the current top 10, and occasionally rebuilt
    // wholesale by the admin "Rekonstruiraj rekorde" action. Reading this
    // instead of scanning every leaderboards/{cat}/scores subcollection is
    // what keeps Rekordi from being an unbounded read that grows with every
    // score ever saved. Same trust ceiling as leaderboards/{cat}/scores
    // above - client-reported, bounded, not authenticated - since this doc
    // is only ever derived from that same data. Firestore rules can't loop
    // over an arbitrary-length list to validate each entry, so this only
    // bounds the doc's shape/size, not each entry's fields.
    // Admin-only time-tracking instrumentation (beta insights) - one doc per
    // browser session, written by the owning client only. Signed-in users
    // only: anonymous play has no stable identity to correlate across
    // visits, so there's nothing meaningful to tag a session with. The
    // client always writes the FULL current gameStateSeconds snapshot
    // (never deltas/increment()), so there's exactly one writer per doc and
    // no read-modify-write race to worry about here.
    function validSessionShape(data) {
      // expiresAt drives the Firestore TTL policy on this collection. Safe to
      // expire because, since playTime counters moved onto users/{uid}, nothing
      // aggregates across sessions any more - only AdminPlayerDetail's
      // uid-scoped query reads them, and only for recent activity.
      // Deliberately NOT applied to questionAttempts/gameResults: those are the
      // source recomputeContentInsightStats() rebuilds from with absolute
      // values, so expiring them would make a later rebuild silently shrink the
      // counters rather than merely cap storage.
      return data.keys().hasOnly(['uid', 'startedAt', 'lastHeartbeat', 'gameStateSeconds', 'expiresAt'])
        && data.uid is string
        && data.lastHeartbeat == request.time
        && (!('expiresAt' in data) || data.expiresAt is timestamp)
        && data.gameStateSeconds is map
        && data.gameStateSeconds.keys().hasOnly(['LOBBY', 'LEADERBOARD', 'PLAYING', 'GAMEOVER', 'VICTORY'])
        && (!('LOBBY' in data.gameStateSeconds) || (data.gameStateSeconds.LOBBY is number && data.gameStateSeconds.LOBBY >= 0 && data.gameStateSeconds.LOBBY <= 86400))
        && (!('LEADERBOARD' in data.gameStateSeconds) || (data.gameStateSeconds.LEADERBOARD is number && data.gameStateSeconds.LEADERBOARD >= 0 && data.gameStateSeconds.LEADERBOARD <= 86400))
        && (!('PLAYING' in data.gameStateSeconds) || (data.gameStateSeconds.PLAYING is number && data.gameStateSeconds.PLAYING >= 0 && data.gameStateSeconds.PLAYING <= 86400))
        && (!('GAMEOVER' in data.gameStateSeconds) || (data.gameStateSeconds.GAMEOVER is number && data.gameStateSeconds.GAMEOVER >= 0 && data.gameStateSeconds.GAMEOVER <= 86400))
        && (!('VICTORY' in data.gameStateSeconds) || (data.gameStateSeconds.VICTORY is number && data.gameStateSeconds.VICTORY >= 0 && data.gameStateSeconds.VICTORY <= 86400));
    }

    match /sessions/{sessionId} {
      allow create: if isOwner(request.resource.data.uid)
        && validSessionShape(request.resource.data)
        && request.resource.data.startedAt == request.time;

      // Owner can only ever heartbeat-update their own session doc, and
      // can't backdate/rewrite when it started.
      allow update: if isOwner(resource.data.uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.startedAt == resource.data.startedAt
        && validSessionShape(request.resource.data);

      allow get: if isOwner(resource.data.uid) || isAdmin();
      allow list: if isAdmin();
      allow delete: if isAdmin();
    }

    // Online-players list (lobby) - one publicly-listable doc per online
    // signed-in player, heartbeat-refreshed the same way as
    // sessions/{sessionId} above but a different purpose: this is meant to
    // be read by other players, not just the owner/admin. Read is
    // signed-in-only rather than fully public (`allow read: if true`) as a
    // safer default - loosening this later to allow signed-out visitors is
    // easy, tightening it after launch is not.
    function validPresenceShape(data) {
      // expiresAt drives a TTL policy that garbage-collects leaked presence
      // docs. deletePresence only runs on explicit logout, so a closed tab
      // leaves its doc behind forever; production had 11 docs of which ~9 were
      // stale. subscribeToOnlinePlayers already filters them out of reads, so
      // this is storage hygiene rather than a read saving.
      return data.keys().hasOnly(['uid', 'displayName', 'level', 'status', 'lastHeartbeat', 'expiresAt'])
        && (!('expiresAt' in data) || data.expiresAt is timestamp)
        && data.uid is string
        && data.displayName is string
        && data.displayName.size() > 0
        && data.displayName.size() <= 20
        && data.level is int
        && data.level >= 1
        && data.status in ['lobby', 'playing', 'busy']
        && data.lastHeartbeat == request.time;
    }

    match /presence/{uid} {
      allow read: if isSignedIn();

      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && validPresenceShape(request.resource.data);

      allow update: if isOwner(uid)
        && request.resource.data.uid == uid
        && validPresenceShape(request.resource.data);

      allow delete: if isOwner(uid) || isAdmin();
    }

    // Gameplay content-insights event log (question accuracy, category
    // popularity, win/loss rate - admin dashboard stats, not a per-tester
    // engagement signal). Unlike sessions/{sessionId} above, these accept
    // BOTH anonymous and signed-in play: accuracy/popularity are about
    // content quality, not who's playing, so restricting to signed-in
    // testers would throw away most of the sample. Bounded/validated the
    // same way leaderboards/{cat}/scores already is (client-computed,
    // public, not authenticated - this only bounds the damage). Ceilings
    // below are derived from constants/gameBalance.js: QUESTION_TIME_SECONDS
    // (20) + PLUS_TEN_SECONDS (10) = 30 max timeLeft; MAX_LIVES = 3;
    // QUESTIONS_PER_ROUND = 10; score ceiling matches the leaderboard rule's
    // own derivation above.
    match /questionAttempts/{attemptId} {
      allow create: if request.resource.data.keys().hasOnly(['uid', 'questionId', 'categoryId', 'correct', 'timeLeft', 'livesRemaining', 'createdAt'])
        && request.resource.data.questionId is string
        && request.resource.data.questionId.size() > 0
        && request.resource.data.questionId.size() <= 100
        && request.resource.data.categoryId is string
        && request.resource.data.categoryId.size() > 0
        && request.resource.data.categoryId.size() <= 50
        && request.resource.data.correct is bool
        && request.resource.data.createdAt == request.time
        && (!('uid' in request.resource.data)
            || request.resource.data.uid == null
            || isOwner(request.resource.data.uid))
        && (!('timeLeft' in request.resource.data)
            || (request.resource.data.timeLeft is number && request.resource.data.timeLeft >= 0 && request.resource.data.timeLeft <= 30))
        && (!('livesRemaining' in request.resource.data)
            || (request.resource.data.livesRemaining is int && request.resource.data.livesRemaining >= 0 && request.resource.data.livesRemaining <= 3));

      allow get, list: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // Maintained per-question counters powering the admin Pregled's accuracy
    // table, kept current incrementally by bumpQuestionStats() on every
    // logQuestionAttempt. Replaces scanning the whole questionAttempts
    // collection at read time (one doc per attempt ever, unbounded) with one
    // bounded doc per question - see CHANGELOG's 2026-08-22 Phase 2 entry.
    //
    // Writable by anyone, signed in or not, exactly like questionAttempts
    // above: the game logs attempts for anonymous play too. The rules below
    // pin every write to a single +1, and pin wrong == total - correct so a
    // caller can't desync the pair. That is the ceiling rules can enforce -
    // a determined caller can still spam *valid* +1 writes to skew a
    // question's stats or burn write quota, exactly as they can spam
    // addDoc(questionAttempts) today. App Check is the mitigation for that,
    // not these rules.
    match /questionStats/{questionId} {
      // Public read: the admin panel reads it, and unlike questionAttempts
      // there is nothing per-player in here - only aggregate counts.
      allow get, list: if true;

      // isAdmin() bypass: recomputeContentInsightStats() rebuilds these from
      // the raw questionAttempts collection with absolute values (setDoc, not
      // increment) so a rebuild corrects drift instead of compounding it -
      // which by definition can't satisfy the +1 delta rules below.
      allow create: if isAdmin() || request.resource.data.keys().hasOnly(['categoryId', 'total', 'correct', 'wrong'])
        && request.resource.data.categoryId is string
        && request.resource.data.categoryId.size() > 0
        && request.resource.data.categoryId.size() <= 50
        && request.resource.data.total == 1
        && request.resource.data.correct is int
        && request.resource.data.wrong is int
        && request.resource.data.correct >= 0
        && request.resource.data.wrong >= 0
        && request.resource.data.correct + request.resource.data.wrong == 1;

      allow update: if isAdmin() || request.resource.data.keys().hasOnly(['categoryId', 'total', 'correct', 'wrong'])
        && request.resource.data.categoryId == resource.data.categoryId
        && request.resource.data.total == resource.data.total + 1
        && (request.resource.data.correct == resource.data.correct + 1
            || request.resource.data.correct == resource.data.correct)
        && request.resource.data.wrong == request.resource.data.total - request.resource.data.correct;

      allow delete: if isAdmin();
    }

    // Maintained per-category counters powering the admin Pregled's
    // popularity table - 8 docs, one per category key, kept current by
    // bumpCategoryStats() on every logGameResult. Same anonymous-write
    // reasoning and the same App Check caveat as questionStats above.
    // totalScore moves by the game's own score, so it's bounded by the same
    // 0..10000 range gameResults.score already validates.
    match /categoryStats/{categoryId} {
      allow get, list: if true;

      // Same isAdmin() rebuild bypass as questionStats above.
      allow create: if isAdmin() || request.resource.data.keys().hasOnly(['plays', 'totalScore', 'victories'])
        && request.resource.data.plays == 1
        && request.resource.data.totalScore is int
        && request.resource.data.totalScore >= 0
        && request.resource.data.totalScore <= 10000
        && request.resource.data.victories is int
        && request.resource.data.victories >= 0
        && request.resource.data.victories <= 1;

      allow update: if isAdmin() || request.resource.data.keys().hasOnly(['plays', 'totalScore', 'victories'])
        && request.resource.data.plays == resource.data.plays + 1
        && request.resource.data.totalScore >= resource.data.totalScore
        && request.resource.data.totalScore <= resource.data.totalScore + 10000
        && (request.resource.data.victories == resource.data.victories + 1
            || request.resource.data.victories == resource.data.victories);

      allow delete: if isAdmin();
    }

    match /gameResults/{resultId} {
      allow create: if request.resource.data.keys().hasOnly(['uid', 'outcome', 'category', 'score', 'questionsAnswered', 'correctAnswers', 'durationMs', 'createdAt'])
        && request.resource.data.outcome in ['VICTORY', 'GAMEOVER']
        && request.resource.data.category is string
        && request.resource.data.category.size() > 0
        && request.resource.data.category.size() <= 50
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 10000
        && request.resource.data.createdAt == request.time
        && (!('uid' in request.resource.data)
            || request.resource.data.uid == null
            || isOwner(request.resource.data.uid))
        && (!('questionsAnswered' in request.resource.data)
            || (request.resource.data.questionsAnswered is int && request.resource.data.questionsAnswered >= 0 && request.resource.data.questionsAnswered <= 10))
        && (!('correctAnswers' in request.resource.data)
            || (request.resource.data.correctAnswers is int && request.resource.data.correctAnswers >= 0 && request.resource.data.correctAnswers <= 10))
        && (!('durationMs' in request.resource.data)
            || (request.resource.data.durationMs is int && request.resource.data.durationMs >= 0 && request.resource.data.durationMs <= 300000));

      allow get, list: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // Player-side "report this question" action + admin Reports queue.
    // Public bounded create (anonymous+signed-in), same reasoning as
    // questionAttempts/gameResults above - a bad question is a bad question
    // regardless of who's signed in. Only admin can read the queue or
    // change status (resolve/dismiss); a report can never self-resolve.
    match /reports/{reportId} {
      allow create: if request.resource.data.keys().hasOnly(['uid', 'questionId', 'categoryId', 'reason', 'note', 'status', 'createdAt'])
        && request.resource.data.questionId is string
        && request.resource.data.questionId.size() > 0
        && request.resource.data.questionId.size() <= 100
        && request.resource.data.categoryId is string
        && request.resource.data.categoryId.size() > 0
        && request.resource.data.categoryId.size() <= 50
        // wrong_explanation: engagement plan Phase 2 (answer explanations).
        && request.resource.data.reason in ['wrong_answer', 'unclear', 'typo', 'offensive', 'wrong_explanation', 'other']
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && (!('uid' in request.resource.data)
            || request.resource.data.uid == null
            || isOwner(request.resource.data.uid))
        && (!('note' in request.resource.data)
            || (request.resource.data.note is string && request.resource.data.note.size() <= 500))
        // Optional answer explanation (engagement plan Phase 2). 220 mirrors
        // EXPLANATION_MAX_LENGTH in src/utils/questionMerge.js - keep equal.
        && (!('explanation' in request.resource.data)
            || (request.resource.data.explanation is string
                && request.resource.data.explanation.size() > 0
                && request.resource.data.explanation.size() <= 220));

      allow get, list: if isAdmin();
      // Resolve/dismiss only - the queue-defining fields can't be rewritten.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['pending', 'resolved', 'dismissed'];
      allow delete: if isAdmin();
    }

    match /questionSubmissions/{submissionId} {
      // Player-proposed new questions (Baza pitanja -> Predložena pitanja).
      // Unlike reports/{reportId}, uid is REQUIRED (submitting requires
      // sign-in) and content fields are validated to the same shape
      // validateEntry (src/utils/questionMerge.js) enforces server-side,
      // since an approved submission is fed straight into that validation.
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['uid', 'category', 'question', 'correct_answer', 'incorrect_answers', 'note', 'explanation', 'status', 'createdAt'])
        && isOwner(request.resource.data.uid)
        && request.resource.data.category is string
        && request.resource.data.category.size() > 0
        && request.resource.data.category.size() <= 50
        && request.resource.data.question is string
        && request.resource.data.question.size() > 0
        && request.resource.data.question.size() <= 500
        && request.resource.data.correct_answer is string
        && request.resource.data.correct_answer.size() > 0
        && request.resource.data.correct_answer.size() <= 200
        && request.resource.data.incorrect_answers is list
        && request.resource.data.incorrect_answers.size() == 3
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && (!('note' in request.resource.data)
            || (request.resource.data.note is string && request.resource.data.note.size() <= 500))
        // Optional answer explanation (engagement plan Phase 2). 220 mirrors
        // EXPLANATION_MAX_LENGTH in src/utils/questionMerge.js - keep equal.
        && (!('explanation' in request.resource.data)
            || (request.resource.data.explanation is string
                && request.resource.data.explanation.size() > 0
                && request.resource.data.explanation.size() <= 220));

      allow get, list: if isAdmin();
      // Approve/reject only - the submitted content can't be rewritten later.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['pending', 'approved', 'rejected'];
      allow delete: if isAdmin();
    }

    match /records/fastestPerfect {
      allow read: if true;

      allow create, update: if request.resource.data.keys().hasOnly(['entries', 'updatedAt'])
        && request.resource.data.entries is list
        && request.resource.data.entries.size() <= 10;

      allow delete: if isAdmin();
    }

    // Maintained top-10 boards for the Rekordi lobby view (level, maxStreak,
    // achievementCount, dayStreak, bestScore) - kept current incrementally
    // by maybeUpdateRekordiProfileBoards (on every publicProfiles sync) and
    // maybeUpdateRekordiBestScore (on every score save), same pattern as
    // records/fastestPerfect above. Lets every client read one bounded doc
    // instead of the 6-query, up-to-121-read fan-out this replaced.
    match /records/rekordiSummary {
      allow read: if true;

      allow create, update: if request.resource.data.keys().hasOnly(
          ['level', 'maxStreak', 'achievementCount', 'dayStreak', 'bestScore', 'updatedAt'])
        && (!('level' in request.resource.data) || (request.resource.data.level is list && request.resource.data.level.size() <= 10))
        && (!('maxStreak' in request.resource.data) || (request.resource.data.maxStreak is list && request.resource.data.maxStreak.size() <= 10))
        && (!('achievementCount' in request.resource.data) || (request.resource.data.achievementCount is list && request.resource.data.achievementCount.size() <= 10))
        && (!('dayStreak' in request.resource.data) || (request.resource.data.dayStreak is list && request.resource.data.dayStreak.size() <= 10))
        && (!('bestScore' in request.resource.data) || (request.resource.data.bestScore is list && request.resource.data.bestScore.size() <= 10));

      allow delete: if isAdmin();
    }

    // Daily Challenge: one free attempt/day per uid, tracked so a client
    // can't submit more than once to dailyLeaderboards. Doc id is
    // "{date}_{uid}" (date = Europe/Zagreb YYYY-MM-DD), create-once - there
    // is no update path since a second attempt is never allowed.
    match /dailyAttempts/{attemptDocId} {
      // Deliberately NOT `isOwner(resource.data.uid)` - that expression
      // errors out (evaluates against a null `resource`) whenever the doc
      // doesn't exist yet, which Firestore treats as a denied read. Since
      // this doc is created lazily on a player's one attempt of the day,
      // that null-resource case is the common case, not an edge case - it
      // broke every player's very first read/attempt of a new day (both
      // getDailyAttemptStatus's getDoc() and startDailyAttempt's tx.get()
      // go through this same rule). Matching the doc id's uid suffix works
      // whether or not the doc exists yet. Firebase Auth uids are
      // alphanumeric with no underscores, so a suffix match on "_{uid}" is
      // unambiguous against the "{date}_{uid}" id shape.
      allow read: if isSignedIn() && attemptDocId.matches('.*_' + request.auth.uid + '$');

      // The only attempt of the day for this uid - doc doesn't exist yet.
      allow create: if isOwner(request.resource.data.uid)
        && request.resource.data.keys().hasOnly(['uid', 'date', 'attemptsUsed', 'updatedAt'])
        && request.resource.data.attemptsUsed == 1
        && request.resource.data.updatedAt == request.time;

      // No update path - once the one daily attempt is recorded, the doc is
      // immutable (no second attempt, paid or otherwise, to escalate to).
      allow update: if false;

      allow delete: if isAdmin();
    }

    // Daily Challenge: one doc per {date,uid} holding only the best score of
    // the day (locked design decision - not one doc per attempt), so the
    // collection is directly queryable by orderBy('score','desc') with no
    // read-time dedup needed. Public read for live standings.
    match /dailyLeaderboards/{date}/scores/{uid} {
      allow read: if true;

      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['uid', 'name', 'score', 'createdAt'])
        && request.resource.data.uid == uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 20
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 10000
        && request.resource.data.createdAt == request.time
        // The write must correspond to the one daily attempt already
        // recorded in dailyAttempts for this exact date/uid - otherwise
        // nothing stops a client writing straight to the leaderboard,
        // bypassing the one-attempt tracking above entirely. One get(),
        // keeping the cross-doc read count in this hot path minimal.
        && get(/databases/$(database)/documents/dailyAttempts/$(date + '_' + uid)).data.attemptsUsed == 1
        // Only accept the write if it's the first score of the day or an
        // improvement over the stored best - mirrors
        // maybeUpdateFastestPerfectRecord's "only write if it beats the
        // current record" pattern, enforced here in rules since the doc id
        // is fixed per-uid rather than auto-generated per attempt.
        && (!exists(/databases/$(database)/documents/dailyLeaderboards/$(date)/scores/$(uid))
            || request.resource.data.score >= resource.data.score);

      allow delete: if isAdmin();
    }

    // Daily Challenge: one doc per date, written only by the scheduled
    // payout job (api/daily-challenge-payout.js) via the Firebase Admin SDK,
    // which bypasses these rules entirely - this match block exists only to
    // make client reads possible (e.g. showing "you won yesterday" on next
    // app open) and to explicitly deny any client write, since paying out
    // coins to arbitrary uids must never be something a browser client can
    // trigger itself.
    match /dailyMeta/{date} {
      allow read: if true;
      allow write: if false;
    }

    // Plan B - 1v1 live invite. Short-lived doc that exists only while an
    // invite awaits a response (accept/decline/60s client-detected expiry).
    // No admin moderation for v1 (locked decision) - deliberately no
    // isAdmin() branch here, matching matches/{matchId} below.
    match /matchInvites/{inviteId} {
      // Either party can read their own invite - the invitee's client
      // queries where('toUid','==',myUid) to show the incoming-invite
      // modal, the inviter's client reads its own sent invite to detect
      // the accept and create the match.
      allow read: if isSignedIn()
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);

      allow create: if isOwner(request.resource.data.fromUid)
        && request.resource.data.keys().hasOnly(['fromUid', 'fromDisplayName', 'toUid', 'category', 'status', 'createdAt', 'expiresAt'])
        && request.resource.data.toUid is string
        && request.resource.data.toUid != request.resource.data.fromUid
        && request.resource.data.fromDisplayName is string
        && request.resource.data.fromDisplayName.size() > 0
        && request.resource.data.fromDisplayName.size() <= 20
        && request.resource.data.category is string
        && request.resource.data.category.size() > 0
        && request.resource.data.category.size() <= 50
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt is timestamp;

      // toUid may only accept/decline; fromUid may only mark it expired
      // (client-detected 60s timeout, see Plan B §6 - there's no server to
      // do this reliably). Nothing about who/what the invite is for can
      // ever change, and a resolved invite can never be reopened.
      allow update: if resource.data.status == 'pending'
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['fromUid', 'fromDisplayName', 'toUid', 'category', 'createdAt', 'expiresAt'])
        && ((isOwner(resource.data.toUid) && request.resource.data.status in ['accepted', 'declined'])
            || (isOwner(resource.data.fromUid) && request.resource.data.status == 'expired'));

      allow delete: if isOwner(resource.data.fromUid) || isOwner(resource.data.toUid);
    }

    // Plan B - 1v1 live invite. The shared, real-time match document both
    // clients read/write for the duration of a match. No server-side
    // authority exists (client-only app - see Plan B §6): rules are the
    // ONLY line of defense for who can write what. No admin moderation for
    // v1 (locked decision).
    //
    // Sudden death: questionIds always holds 11 ids, chosen once at create
    // time (10 for the fixed round + 1 pre-selected reserve). currentQuestionIndex
    // reaching 10 means the match is in its sudden-death question - there is
    // no live re-pick, so no new authority problem is introduced.
    match /matches/{matchId} {
      allow read: if isMatchParticipant(resource.data);

      allow create: if isOwner(request.resource.data.player1Uid)
        && request.resource.data.keys().hasOnly([
             'player1Uid', 'player2Uid', 'player1DisplayName', 'player2DisplayName',
             'category', 'questionIds', 'status', 'currentQuestionIndex',
             'questionStartedAt', 'player1Answer', 'player2Answer',
             'player1Score', 'player2Score', 'player1Correct', 'player2Correct',
             'lastActivityAt',
             'winnerUid', 'createdAt', 'inviteId', 'countdownStartedAt'
           ])
        && request.resource.data.player2Uid is string
        && request.resource.data.player2Uid != request.resource.data.player1Uid
        && request.resource.data.player1DisplayName is string
        && request.resource.data.player1DisplayName.size() > 0
        && request.resource.data.player1DisplayName.size() <= 20
        && request.resource.data.player2DisplayName is string
        && request.resource.data.player2DisplayName.size() > 0
        && request.resource.data.player2DisplayName.size() <= 20
        && request.resource.data.category is string
        && request.resource.data.category.size() > 0
        && request.resource.data.category.size() <= 50
        && request.resource.data.questionIds is list
        && request.resource.data.questionIds.size() == 11
        && request.resource.data.status == 'waiting_ready'
        && request.resource.data.currentQuestionIndex == 0
        && request.resource.data.questionStartedAt == null
        && request.resource.data.player1Answer == null
        && request.resource.data.player2Answer == null
        && request.resource.data.player1Score == 0
        && request.resource.data.player2Score == 0
        && request.resource.data.player1Correct == 0
        && request.resource.data.player2Correct == 0
        && request.resource.data.winnerUid == null
        && request.resource.data.countdownStartedAt == null
        && request.resource.data.lastActivityAt == request.time
        && request.resource.data.createdAt == request.time
        // Must correspond to an invite the invitee actually accepted,
        // targeting this exact pairing and category - prevents a client
        // from creating a match against someone who never agreed to it.
        && request.resource.data.inviteId is string
        && get(/databases/$(database)/documents/matchInvites/$(request.resource.data.inviteId)).data.status == 'accepted'
        && get(/databases/$(database)/documents/matchInvites/$(request.resource.data.inviteId)).data.fromUid == request.resource.data.player1Uid
        && get(/databases/$(database)/documents/matchInvites/$(request.resource.data.inviteId)).data.toUid == request.resource.data.player2Uid
        && get(/databases/$(database)/documents/matchInvites/$(request.resource.data.inviteId)).data.category == request.resource.data.category;

      allow update: if isMatchParticipant(resource.data)
        && !matchIsTerminal()
        && matchIdentityUnchanged()
        && (
          // General "match still alive" heartbeat - either participant,
          // any time. Kept alongside the PER-PLAYER heartbeat fields below
          // (not a replacement) - this one alone can't be used for forfeit
          // detection since either player heartbeating it keeps it fresh
          // regardless of whether the OTHER player is still there; it's
          // just a lightweight generic liveness signal.
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastActivityAt'])
            && request.resource.data.lastActivityAt == request.time)

          // First Spreman click: waiting_ready -> countdown. First write
          // wins (countdownStartedAt can only move null -> set), so both
          // players' 5s pre-match countdowns anchor to the same server
          // timestamp instead of each client's own click time.
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'countdownStartedAt', 'lastActivityAt'])
              && resource.data.status == 'waiting_ready'
              && resource.data.countdownStartedAt == null
              && request.resource.data.status == 'countdown'
              && request.resource.data.countdownStartedAt == request.time
              && request.resource.data.lastActivityAt == request.time)

          // Start the match once the countdown elapses: countdown ->
          // question_active. First client whose local 5s timer (anchored to
          // countdownStartedAt) fires wins this write.
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'lastActivityAt'])
              && resource.data.status == 'countdown'
              && request.resource.data.status == 'question_active'
              && request.resource.data.lastActivityAt == request.time)

          // First client to reach the question sets questionStartedAt -
          // "first write wins" since it can only ever move null -> set,
          // never be overwritten (see Plan B §6 on this being a deliberate,
          // rules-resolved race rather than a server-arbitrated one).
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['questionStartedAt', 'lastActivityAt'])
              && resource.data.status == 'question_active'
              && resource.data.questionStartedAt == null
              && request.resource.data.questionStartedAt == request.time
              && request.resource.data.lastActivityAt == request.time)

          // player1 answers AND self-reports score/correct-count in ONE
          // write (both fields optional-but-validated-if-present, via the
          // same "!(x in diff) || <check>" pattern as the optional fields
          // in leaderboards/scores above) - this MUST be a single atomic
          // write, not two separate ones (submit answer, then separately
          // update score), because two sequential writes leave a window
          // where reveal/finish can fire (gated only on both players'
          // Answer fields being set) BEFORE the second write lands,
          // finalizing the match with a stale score for whichever player's
          // score update hadn't arrived yet - caught live via
          // two-player-match-check.mjs's simultaneous-play run, which
          // produced two contexts disagreeing on the final score. Answer
          // itself still only ever moves null -> set, never overwritten,
          // and player1 can never see/write player2Answer/player2Score.
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['player1Answer', 'player1Score', 'player1Correct', 'lastActivityAt'])
              && isOwner(resource.data.player1Uid)
              && resource.data.status == 'question_active'
              && request.resource.data.lastActivityAt == request.time
              && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['player1Answer'])
                  || (resource.data.player1Answer == null
                      && request.resource.data.player1Answer.keys().hasOnly(['optionIndex', 'answeredAt'])
                      && request.resource.data.player1Answer.optionIndex is int
                      && request.resource.data.player1Answer.optionIndex >= 0
                      && request.resource.data.player1Answer.optionIndex <= 3
                      && request.resource.data.player1Answer.answeredAt == request.time))
              && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['player1Score'])
                  || (request.resource.data.player1Score is int
                      && request.resource.data.player1Score >= resource.data.player1Score
                      && request.resource.data.player1Score <= 8000))
              && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['player1Correct'])
                  || (request.resource.data.player1Correct is int
                      && request.resource.data.player1Correct >= resource.data.player1Correct
                      && request.resource.data.player1Correct <= resource.data.player1Correct + 1
                      && request.resource.data.player1Correct <= 11)))

          // player2 answers/self-reports - symmetric to player1 above.
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['player2Answer', 'player2Score', 'player2Correct', 'lastActivityAt'])
              && isOwner(resource.data.player2Uid)
              && resource.data.status == 'question_active'
              && request.resource.data.lastActivityAt == request.time
              && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['player2Answer'])
                  || (resource.data.player2Answer == null
                      && request.resource.data.player2Answer.keys().hasOnly(['optionIndex', 'answeredAt'])
                      && request.resource.data.player2Answer.optionIndex is int
                      && request.resource.data.player2Answer.optionIndex >= 0
                      && request.resource.data.player2Answer.optionIndex <= 3
                      && request.resource.data.player2Answer.answeredAt == request.time))
              && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['player2Score'])
                  || (request.resource.data.player2Score is int
                      && request.resource.data.player2Score >= resource.data.player2Score
                      && request.resource.data.player2Score <= 8000))
              && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['player2Correct'])
                  || (request.resource.data.player2Correct is int
                      && request.resource.data.player2Correct >= resource.data.player2Correct
                      && request.resource.data.player2Correct <= resource.data.player2Correct + 1
                      && request.resource.data.player2Correct <= 11)))

          // Reveal the current question - either participant, no other
          // field changes (scores are written separately, see above).
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'lastActivityAt'])
              && resource.data.status == 'question_active'
              && request.resource.data.status == 'reveal'
              && request.resource.data.lastActivityAt == request.time)

          // Advance to the next question (also covers entering sudden
          // death, index 9 -> 10 - same transition shape, just one further
          // than a normal round would ever reach). Resets the per-question
          // fields so the next question starts clean.
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'currentQuestionIndex', 'questionStartedAt', 'player1Answer', 'player2Answer', 'lastActivityAt'])
              && resource.data.status == 'reveal'
              && request.resource.data.status == 'question_active'
              && request.resource.data.currentQuestionIndex == resource.data.currentQuestionIndex + 1
              && request.resource.data.currentQuestionIndex <= 10
              && request.resource.data.questionStartedAt == null
              && request.resource.data.player1Answer == null
              && request.resource.data.player2Answer == null
              && request.resource.data.lastActivityAt == request.time)

          // Finish the match from the last reveal (either the 10th question
          // with no tie, or the sudden-death 11th question) - becomes
          // immutable immediately after via matchIsTerminal() above.
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'winnerUid', 'lastActivityAt'])
              && resource.data.status == 'reveal'
              && request.resource.data.status == 'match_over'
              && (request.resource.data.winnerUid == null
                  || request.resource.data.winnerUid == resource.data.player1Uid
                  || request.resource.data.winnerUid == resource.data.player2Uid)
              && request.resource.data.lastActivityAt == request.time)

          // Forfeit - either participant may report the OTHER player as
          // inactive (never themselves - winnerUid must be their opponent,
          // not their own uid) from any non-terminal status. No server
          // exists to verify the 30s inactivity claim independently (see
          // Plan B §6) - this is a deliberate, documented v1 limit.
          // forfeitReason ('manual' | 'timeout') is optional-but-validated-
          // if-present (older/other-path writes without it still validate)
          // so MatchView.jsx can show different copy for a deliberate quit
          // vs. a stale-heartbeat auto-forfeit.
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'winnerUid', 'forfeitReason', 'lastActivityAt'])
              && request.resource.data.status == 'forfeited'
              && request.resource.data.winnerUid != request.auth.uid
              && (request.resource.data.winnerUid == resource.data.player1Uid || request.resource.data.winnerUid == resource.data.player2Uid)
              && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['forfeitReason'])
                  || request.resource.data.forfeitReason in ['manual', 'timeout'])
              && request.resource.data.lastActivityAt == request.time)
        );

      // No client delete - orphaned match cleanup is deferred (see Plan B
      // §6/CLAUDE.md), same as presence/{uid}'s stale-doc handling.
      allow delete: if false;

      // Per-player heartbeat, split into its own subcollection (one doc per
      // participant) rather than fields on the match doc itself - Firestore
      // onSnapshot re-fires on ANY field change to a listened document, so
      // colocating a ~15s heartbeat write with the doc both players'
      // gameplay listeners watch (subscribeToMatch) doubled the read cost of
      // every heartbeat for no gameplay-relevant information. This is what
      // forfeit detection reads: if the OPPONENT's heartbeat doc has gone
      // stale, I know specifically THEY'VE gone quiet (see the general
      // lastActivityAt heartbeat above for why a shared signal alone can't
      // distinguish that).
      //
      // Deliberately NOT cross-checked against the parent match doc via
      // get() here (unlike matches/{matchId}'s own create rule) - a get()
      // call in rules bills as an extra document read on every single
      // evaluation, which on a ~15s write interval would silently re-add
      // most of the read cost this split is meant to remove. matchId is an
      // unguessable Firestore auto-id, so a non-participant would need to
      // already know it to read/write here; the worst case of skipping the
      // cross-check is a stray, inert heartbeat doc under a match id the
      // writer isn't actually part of, which no opponent ever subscribes to
      // (MatchView only subscribes to the real oppUid it read off the
      // match doc). Same trust-model tradeoff as the app's other
      // self-reported, rules-bounded-not-rules-verified fields.
      match /heartbeats/{uid} {
        allow read: if isSignedIn();
        allow write: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['heartbeatAt'])
          && request.resource.data.heartbeatAt == request.time;
        allow delete: if false;
      }
    }

    // ---------------------------------------------------------------------
    // Async duels (engagement plan Phase 4) - a SEPARATE subsystem from the
    // live matches/ collection above. Ten questions, answered by each player
    // at a different time, within 48 h of creation.
    //
    //   asyncDuels/{duelId}               parent: who, what, status, winner
    //   asyncDuels/{duelId}/results/{uid} one per player: their run
    //
    // Status flow: open (random, unclaimed) -> awaiting_opponent -> complete
    // | expired. A random duel is created `open` and claimed by the first
    // other player to play it (opponentUid null -> that uid).
    //
    // Hiding the first player's score from the second is the core of the
    // design: a result doc is readable by its owner, and by the OTHER player
    // only once that other player has `done` their own run. (The plan first
    // said "once the parent is complete", but that deadlocks if the client
    // that finished second dies before writing `complete` - nobody could
    // read the numbers needed to write the winner. Gating on "my own run is
    // done" hides the score exactly as long, and lets any participant
    // reconcile.)
    //
    // Scores are client-computed - the same trust level as solo leaderboards
    // and live 1v1 - but the winner can't be forged: the `complete` update
    // must carry the winner the two stored results imply (getAfter() sees
    // the result write in the same batch).
    // ---------------------------------------------------------------------
    function isDuelParticipant(d) {
      return isSignedIn() && (d.challengerUid == request.auth.uid || d.opponentUid == request.auth.uid);
    }

    function duelResultPath(duelId, uid) {
      return /databases/$(database)/documents/asyncDuels/$(duelId)/results/$(uid);
    }

    // Winner implied by two `done` results: higher score; tie -> lower
    // totalTimeMs; exact tie -> null (a draw). Mirrors decideWinner() in
    // src/utils/asyncDuel.js.
    function expectedDuelWinner(d, a, b) {
      return a.score > b.score ? d.challengerUid
        : b.score > a.score ? d.opponentUid
        : a.totalTimeMs < b.totalTimeMs ? d.challengerUid
        : b.totalTimeMs < a.totalTimeMs ? d.opponentUid
        : null;
    }

    match /asyncDuels/{duelId} {
      // Participants read their duels. Unclaimed random duels are readable by
      // any signed-in user (the pool query) - they carry no score.
      allow get, list: if isAdmin()
        || isDuelParticipant(resource.data)
        || (isSignedIn() && resource.data.status == 'open');

      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['mode', 'challengerUid', 'challengerName', 'opponentUid', 'opponentName', 'category', 'questionIds', 'status', 'createdAt', 'expiresAt'])
        && request.resource.data.challengerUid == request.auth.uid
        && request.resource.data.challengerName is string
        && request.resource.data.challengerName.size() > 0
        && request.resource.data.challengerName.size() <= 20
        && request.resource.data.category is string
        && request.resource.data.category.size() > 0
        && request.resource.data.category.size() <= 50
        && request.resource.data.questionIds is list
        && request.resource.data.questionIds.size() == 10
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt >= request.time + duration.value(48, 'h') - duration.value(1, 'm')
        && request.resource.data.expiresAt <= request.time + duration.value(48, 'h') + duration.value(1, 'm')
        && (
          (request.resource.data.mode == 'direct'
            && request.resource.data.status == 'awaiting_opponent'
            && request.resource.data.opponentUid is string
            && request.resource.data.opponentUid != request.auth.uid
            && request.resource.data.opponentName is string
            && request.resource.data.opponentName.size() > 0
            && request.resource.data.opponentName.size() <= 20)
          ||
          (request.resource.data.mode == 'random'
            && request.resource.data.status == 'open'
            && request.resource.data.opponentUid == null
            && request.resource.data.opponentName == null)
        );

      allow update: if isSignedIn() && (
        // Claim an unclaimed random duel: only the opponent slot and status
        // change, the claimer is not the challenger, and it isn't expired.
        (resource.data.status == 'open'
          && resource.data.opponentUid == null
          && request.auth.uid != resource.data.challengerUid
          && request.time < resource.data.expiresAt
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['opponentUid', 'opponentName', 'status'])
          && request.resource.data.opponentUid == request.auth.uid
          && request.resource.data.opponentName is string
          && request.resource.data.opponentName.size() > 0
          && request.resource.data.opponentName.size() <= 20
          && request.resource.data.status == 'awaiting_opponent')
        ||
        // Complete: a participant, with both results `done` once this write
        // lands (getAfter), and the stored winner matching the numbers.
        (isDuelParticipant(resource.data)
          && resource.data.status == 'awaiting_opponent'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'winnerUid', 'completedAt'])
          && request.resource.data.status == 'complete'
          && request.resource.data.completedAt == request.time
          && getAfter(duelResultPath(duelId, resource.data.challengerUid)).data.state == 'done'
          && getAfter(duelResultPath(duelId, resource.data.opponentUid)).data.state == 'done'
          && request.resource.data.winnerUid == expectedDuelWinner(
               resource.data,
               getAfter(duelResultPath(duelId, resource.data.challengerUid)).data,
               getAfter(duelResultPath(duelId, resource.data.opponentUid)).data))
        ||
        // Expire: a participant, only after expiresAt, never a finished duel.
        (isDuelParticipant(resource.data)
          && (resource.data.status == 'open' || resource.data.status == 'awaiting_opponent')
          && request.time > resource.data.expiresAt
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status == 'expired')
      );

      // Admin cleanup only (the cron sweep uses the Admin SDK and bypasses rules).
      allow delete: if isAdmin();

      match /results/{resultUid} {
        // Owner always; the other player only after finishing their OWN run.
        allow get: if isAdmin()
          || isOwner(resultUid)
          || (isSignedIn()
              && exists(duelResultPath(duelId, request.auth.uid))
              && get(duelResultPath(duelId, request.auth.uid)).data.state == 'done');
        allow list: if false;

        // Start a run: once per player (a second create is an update, which
        // the rules below only allow in_progress -> done), only for a duel
        // the caller is in and that hasn't expired. Created BEFORE the first
        // question is shown, so abandoning still consumes the attempt.
        allow create: if isOwner(resultUid)
          && request.resource.data.keys().hasOnly(['state', 'startedAt', 'score', 'correct', 'totalTimeMs', 'answers', 'rewardClaimed'])
          && request.resource.data.state == 'in_progress'
          && request.resource.data.startedAt == request.time
          && request.resource.data.score == 0
          && request.resource.data.correct == 0
          && request.resource.data.totalTimeMs == 0
          && request.resource.data.answers == []
          && request.resource.data.rewardClaimed == false
          && isDuelParticipant(get(/databases/$(database)/documents/asyncDuels/$(duelId)).data)
          && (get(/databases/$(database)/documents/asyncDuels/$(duelId)).data.status == 'open'
              || get(/databases/$(database)/documents/asyncDuels/$(duelId)).data.status == 'awaiting_opponent')
          && request.time < get(/databases/$(database)/documents/asyncDuels/$(duelId)).data.expiresAt;

        allow update: if isOwner(resultUid) && (
          // Finish: in_progress -> done, once, with plausible final numbers.
          (resource.data.state == 'in_progress'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state', 'finishedAt', 'score', 'correct', 'totalTimeMs', 'answers'])
            && request.resource.data.state == 'done'
            && request.resource.data.finishedAt == request.time
            && request.resource.data.score is int
            && request.resource.data.score >= 0
            && request.resource.data.score <= 10000
            && request.resource.data.correct is int
            && request.resource.data.correct >= 0
            && request.resource.data.correct <= 10
            && request.resource.data.totalTimeMs is int
            && request.resource.data.totalTimeMs >= 0
            && request.resource.data.totalTimeMs <= 200000
            && request.resource.data.answers is list
            && request.resource.data.answers.size() == 10)
          ||
          // Claim the reward: only after the duel is complete, false -> true, once.
          (resource.data.state == 'done'
            && resource.data.rewardClaimed == false
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rewardClaimed'])
            && request.resource.data.rewardClaimed == true
            && get(/databases/$(database)/documents/asyncDuels/$(duelId)).data.status == 'complete')
        );

        allow delete: if isAdmin();
      }
    }

    // ------------------------------------------------------------------
    // Weekly + seasonal leaderboards (engagement plan Phase 5).
    //
    // weeklyBoards/{weekKey}/players/{uid}  - a player's five best round
    //   scores of that ISO week (Zagreb calendar), s1 >= ... >= s5, with
    //   total = s1+...+s5 (the ranking key). weekKey is "YYYY-Www".
    // seasonBoards/{seasonId}/players/{uid} - `weeks` maps weekKey -> that
    //   week's total; `total` is the sum of the five best of them. Rules can
    //   not sort a map, so the season total is only BOUNDED here (see below).
    // badges/{uid}                          - season badges, Admin SDK only.
    //
    // Same trust ceiling as leaderboards/{category}/scores: scores are
    // client-computed, so these rules bound the damage rather than prove a
    // round happened. What they do enforce:
    //  - owner-only writes; the parent weeklyBoards/{weekKey} and
    //    seasonBoards/{seasonId} docs (payout metadata) are Admin-SDK only;
    //  - a weekly doc starts as ONE round (s2..s5 == 0) and each update must
    //    be a single top-5 insertion: every slot only rises and never
    //    exceeds the slot above its old value (o_i <= n_i <= o_{i-1}), and
    //    the total grows by at most one round's maximum (10000). Forging a
    //    week therefore takes one plausible-looking write per round;
    //  - a season doc's total can only rise, by at most 10000 per write
    //    (one round lifts a weekly total by at most that, and the best-five
    //    sum by no more than the weekly total rose). A season doc is created
    //    holding exactly one week, whose total is at most a full week's
    //    ceiling (5 x 10000) - not 10000, because a player whose weekly doc
    //    already exists can legitimately meet a missing season doc.
    // Not enforced (rules can't compute it): that weekKey is the CURRENT
    // week, that `weeks` mirrors the weekly docs, or the per-week values.
    // The cron's payout reads only totals, so the blast radius of a forged
    // value is the same as a forged leaderboard score.
    // ------------------------------------------------------------------
    function weeklyBoardShapeOk(d) {
      return d.keys().hasOnly(['name', 's1', 's2', 's3', 's4', 's5', 'total', 'updatedAt'])
        && d.name is string
        && d.name.size() > 0
        && d.name.size() <= 20
        && d.s1 is int && d.s1 >= 0 && d.s1 <= 10000
        && d.s2 is int && d.s2 >= 0 && d.s2 <= d.s1
        && d.s3 is int && d.s3 >= 0 && d.s3 <= d.s2
        && d.s4 is int && d.s4 >= 0 && d.s4 <= d.s3
        && d.s5 is int && d.s5 >= 0 && d.s5 <= d.s4
        && d.total is int
        && d.total == d.s1 + d.s2 + d.s3 + d.s4 + d.s5
        && d.updatedAt == request.time;
    }

    function seasonBoardShapeOk(d) {
      return d.keys().hasOnly(['name', 'weeks', 'total', 'updatedAt'])
        && d.name is string
        && d.name.size() > 0
        && d.name.size() <= 20
        && d.weeks is map
        && d.weeks.size() >= 1
        && d.weeks.size() <= 12
        && d.total is int
        && d.total >= 0
        && d.total <= 250000
        && d.updatedAt == request.time;
    }

    match /weeklyBoards/{weekKey} {
      // Payout metadata ({ paidAt, tiers, winners }), written by
      // api/daily-challenge-payout.js through the Admin SDK only.
      allow read: if true;
      allow write: if false;

      match /players/{uid} {
        allow read: if true;

        allow create: if isOwner(uid)
          && weekKey.matches('^[0-9]{4}-W[0-9]{2}$')
          && weeklyBoardShapeOk(request.resource.data)
          && request.resource.data.s1 > 0
          && request.resource.data.s2 == 0
          && request.resource.data.s3 == 0
          && request.resource.data.s4 == 0
          && request.resource.data.s5 == 0;

        allow update: if isOwner(uid)
          && weekKey.matches('^[0-9]{4}-W[0-9]{2}$')
          && weeklyBoardShapeOk(request.resource.data)
          && request.resource.data.s1 >= resource.data.s1
          && request.resource.data.s2 >= resource.data.s2 && request.resource.data.s2 <= resource.data.s1
          && request.resource.data.s3 >= resource.data.s3 && request.resource.data.s3 <= resource.data.s2
          && request.resource.data.s4 >= resource.data.s4 && request.resource.data.s4 <= resource.data.s3
          && request.resource.data.s5 >= resource.data.s5 && request.resource.data.s5 <= resource.data.s4
          && request.resource.data.total - resource.data.total <= 10000;

        allow delete: if isAdmin();
      }
    }

    match /seasonBoards/{seasonId} {
      allow read: if true;
      allow write: if false;

      match /players/{uid} {
        allow read: if true;

        allow create: if isOwner(uid)
          && seasonId.matches('^s[0-9]{1,3}$')
          && seasonBoardShapeOk(request.resource.data)
          && request.resource.data.weeks.size() == 1
          && request.resource.data.total <= 50000;

        allow update: if isOwner(uid)
          && seasonId.matches('^s[0-9]{1,3}$')
          && seasonBoardShapeOk(request.resource.data)
          && request.resource.data.total >= resource.data.total
          && request.resource.data.total - resource.data.total <= 10000;

        allow delete: if isAdmin();
      }
    }

    // Season badges ("s1_gold", "s1_top10", ...). No client writes at all -
    // only the cron (Admin SDK) awards them. Deliberately NOT a field on
    // publicProfiles: syncPublicProfile overwrites that doc with a
    // non-merge setDoc, which would wipe any extra field on the next sync.
    match /badges/{uid} {
      allow read: if true;
      allow write: if false;
    }

    // ------------------------------------------------------------------
    // Private leagues (engagement plan Phase 6).
    //
    // leagues/{leagueId}                 name, emoji, ownerUid, code,
    //                                    memberCount, createdAt - readable by
    //                                    members only
    // leagues/{leagueId}/members/{uid}   name, joinedAt, code (the code used
    //                                    to join; checked against the
    //                                    league's CURRENT code, so rotating
    //                                    the code locks out old links)
    // leagueCodes/{code}                 { leagueId, name, emoji } - `get` for
    //                                    signed-in users, `list` denied, so
    //                                    codes can't be enumerated. name/emoji
    //                                    are copied here (and kept in sync by
    //                                    the owner) so a joiner can see which
    //                                    league they're joining without read
    //                                    access to it.
    //
    // Every multi-doc change is ONE client batch and these rules tie the
    // docs together with get()/getAfter()/existsAfter():
    //  - create league: league (memberCount 1) + owner's member doc + code doc
    //  - join:   member doc + league memberCount +1 (<= 50)
    //  - leave:  member doc delete + memberCount -1 (the owner also hands
    //            ownerUid to another member in the same update; the last
    //            member deletes the league, its code doc and own member doc)
    //  - kick:   owner deletes a member doc + memberCount -1
    // memberCount can therefore only go up by joining (with the right code)
    // and only go down by the leaver's own member doc disappearing or by the
    // owner. The owner is trusted about their own league's count.
    // Not enforced: the 5-leagues-per-player cap (client-side; the index doc
    // under users/{uid} is a cache, not an authority) and name content (no
    // profanity filter - the admin can delete a league).
    // ------------------------------------------------------------------
    function leagueMemberShapeOk(d) {
      return d.keys().hasOnly(['name', 'joinedAt', 'code'])
        && d.name is string
        && d.name.size() > 0
        && d.name.size() <= 20
        && d.code is string
        && d.code.matches('^[A-HJ-NP-Z2-9]{6}$')
        && d.joinedAt == request.time;
    }

    match /leagues/{leagueId} {
      // Helpers return booleans / data maps (not paths) - the plainest form
      // of get()/exists() helper the rules language documents.
      function leagueExists() {
        return exists(/databases/$(database)/documents/leagues/$(leagueId));
      }
      function leagueBefore() {
        return get(/databases/$(database)/documents/leagues/$(leagueId)).data;
      }
      function leagueAfter() {
        return getAfter(/databases/$(database)/documents/leagues/$(leagueId)).data;
      }
      function hasMember(memberUid) {
        return exists(/databases/$(database)/documents/leagues/$(leagueId)/members/$(memberUid));
      }
      function hasMemberAfter(memberUid) {
        return existsAfter(/databases/$(database)/documents/leagues/$(leagueId)/members/$(memberUid));
      }
      function leagueShapeOk(d) {
        return d.keys().hasOnly(['name', 'emoji', 'ownerUid', 'code', 'memberCount', 'createdAt'])
          && d.name is string
          && d.name.size() > 0
          && d.name.size() <= 30
          && d.emoji is string
          && d.emoji.size() > 0
          && d.emoji.size() <= 8
          && d.ownerUid is string
          && d.code is string
          && d.code.matches('^[A-HJ-NP-Z2-9]{6}$')
          && d.memberCount is int
          && d.memberCount >= 0
          && d.memberCount <= 50;
      }
      function leagueChangedKeys() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }
      // Owner edits name/emoji/code, hands the league over (to an existing
      // member), or lowers memberCount by one (kick / leaving).
      function leagueOwnerEditOk() {
        return isOwner(resource.data.ownerUid)
          && leagueChangedKeys().hasOnly(['name', 'emoji', 'code', 'ownerUid', 'memberCount'])
          && (request.resource.data.ownerUid == resource.data.ownerUid
              || hasMember(request.resource.data.ownerUid))
          && (request.resource.data.memberCount == resource.data.memberCount
              || request.resource.data.memberCount == resource.data.memberCount - 1);
      }
      // A newcomer: their member doc is created in the same batch and the
      // count rises by exactly one, never past 50.
      function leagueJoinOk() {
        return isSignedIn()
          && leagueChangedKeys().hasOnly(['memberCount'])
          && request.resource.data.memberCount == resource.data.memberCount + 1
          && !hasMember(request.auth.uid)
          && hasMemberAfter(request.auth.uid);
      }
      // A member leaving: their own member doc is deleted in the same batch.
      function leagueSelfLeaveOk() {
        return isSignedIn()
          && leagueChangedKeys().hasOnly(['memberCount'])
          && request.resource.data.memberCount == resource.data.memberCount - 1
          && hasMember(request.auth.uid)
          && !hasMemberAfter(request.auth.uid);
      }

      // Members only. `get` only: a non-admin can't list leagues (the app
      // reaches a league through the player's own users/{uid}/leagues index).
      allow get: if isAdmin()
        || (isSignedIn() && hasMember(request.auth.uid));
      allow list: if isAdmin();

      allow create: if isSignedIn()
        && leagueShapeOk(request.resource.data)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberCount == 1
        && request.resource.data.createdAt == request.time
        && hasMemberAfter(request.auth.uid);

      allow update: if isAdmin()
        || (leagueShapeOk(request.resource.data)
            && (leagueOwnerEditOk() || leagueJoinOk() || leagueSelfLeaveOk()));

      // The owner can only delete an (effectively) empty league - i.e. the
      // last member leaving. Admin can delete any (moderation).
      allow delete: if isAdmin()
        || (isOwner(resource.data.ownerUid) && resource.data.memberCount <= 1);

      match /members/{memberUid} {
        allow read: if isAdmin()
          || (isSignedIn() && hasMember(request.auth.uid));

        allow create: if isOwner(memberUid)
          && leagueMemberShapeOk(request.resource.data)
          && (
            // Joining an existing league with its current code.
            (leagueExists()
              && request.resource.data.code == leagueBefore().code
              && leagueAfter().memberCount == leagueBefore().memberCount + 1
              && leagueAfter().memberCount <= 50)
            ||
            // The owner's own member doc, created in the batch that creates the league.
            (!leagueExists()
              && leagueAfter().ownerUid == request.auth.uid
              && request.resource.data.code == leagueAfter().code)
          );

        // A member doc never changes after creation.
        allow update: if false;

        // Leave (self), kick (owner), moderation (admin).
        allow delete: if isOwner(memberUid)
          || isAdmin()
          || (isSignedIn() && leagueBefore().ownerUid == request.auth.uid);
      }
    }

    match /leagueCodes/{code} {
      function leagueBeforeOf(id) {
        return get(/databases/$(database)/documents/leagues/$(id)).data;
      }
      function leagueAfterOf(id) {
        return getAfter(/databases/$(database)/documents/leagues/$(id)).data;
      }
      // The league as it will be once the batch lands - so the owner can
      // create the code doc in the same batch as the league (or a new code
      // doc in the batch that rotates the league's code).
      function leagueCodeShapeOk(d) {
        return d.keys().hasOnly(['leagueId', 'name', 'emoji'])
          && d.leagueId is string
          && d.name is string
          && d.name.size() > 0
          && d.name.size() <= 30
          && d.emoji is string
          && d.emoji.size() > 0
          && d.emoji.size() <= 8;
      }
      function leagueCodeMatchesLeague(d) {
        return leagueAfterOf(d.leagueId).ownerUid == request.auth.uid
          && leagueAfterOf(d.leagueId).code == code
          && leagueAfterOf(d.leagueId).name == d.name
          && leagueAfterOf(d.leagueId).emoji == d.emoji;
      }

      // One code at a time, never a listing: codes are unguessable only
      // because they can't be enumerated.
      allow get: if isSignedIn();
      allow list: if false;

      allow create: if isSignedIn()
        && code.matches('^[A-HJ-NP-Z2-9]{6}$')
        && leagueCodeShapeOk(request.resource.data)
        && leagueCodeMatchesLeague(request.resource.data);

      // Rename/emoji sync by the league's owner. A create that collides with
      // an existing code of ANOTHER league lands here and fails the
      // leagueId check - the client then draws a new code.
      allow update: if isSignedIn()
        && leagueCodeShapeOk(request.resource.data)
        && request.resource.data.leagueId == resource.data.leagueId
        && leagueCodeMatchesLeague(request.resource.data);

      allow delete: if isAdmin()
        || (isSignedIn() && leagueBeforeOf(resource.data.leagueId).ownerUid == request.auth.uid);
    }

    // Plan B - 1v1 match history. Each participant writes their OWN summary
    // of a finished match into their own slice on match_over - owner-only
    // read, same pattern as users/{uid}. Immutable once written (no update
    // path) since a finished match's result should never change.
    match /matchHistory/{uid}/entries/{matchId} {
      allow read: if isOwner(uid) || isAdmin();

      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['opponentUid', 'opponentDisplayName', 'result', 'myScore', 'opponentScore', 'category', 'createdAt', 'forfeited', 'async'])
        && request.resource.data.opponentUid is string
        && request.resource.data.opponentDisplayName is string
        && request.resource.data.opponentDisplayName.size() > 0
        && request.resource.data.opponentDisplayName.size() <= 20
        && request.resource.data.result in ['win', 'loss', 'draw']
        && request.resource.data.myScore is int
        && request.resource.data.myScore >= 0
        && request.resource.data.myScore <= 8000
        && request.resource.data.opponentScore is int
        && request.resource.data.opponentScore >= 0
        && request.resource.data.opponentScore <= 8000
        && request.resource.data.category is string
        && request.resource.data.category.size() > 0
        && request.resource.data.category.size() <= 50
        && (!('forfeited' in request.resource.data) || request.resource.data.forfeited is bool)
        && (!('async' in request.resource.data) || request.resource.data.async is bool)
        && request.resource.data.createdAt == request.time;

      allow update, delete: if isAdmin();
    }
  }
}
