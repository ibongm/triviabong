rules_version = '2';

// Deploy with: firebase deploy --only firestore:rules
// (requires `firebase login` and the project already set in .firebaserc)

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Mirrors ADMIN_EMAIL in src/App.jsx. Keep these two in sync manually —
    // if the admin email ever changes, update it in both places.
    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'ivanm.ploce@gmail.com';
    }

    match /users/{uid} {
      // Only the owner or an admin can read a specific profile.
      allow get: if isOwner(uid) || isAdmin();
      // Only an admin can list the whole users collection (AdminPanel).
      allow list: if isAdmin();

      // Created by syncUserProfile() on first login — owner only, and it
      // can't seed itself with privileged fields.
      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && !('role' in request.resource.data)
        && (!('level' in request.resource.data) || (request.resource.data.level is int && request.resource.data.level >= 1))
        && (!('xp' in request.resource.data) || (request.resource.data.xp is int && request.resource.data.xp >= 0))
        && (!('coins' in request.resource.data) || (request.resource.data.coins is int && request.resource.data.coins >= 0));

      // Owner can update their own doc (e.g. syncUserStatsToFirestore
      // merges level/xp/coins) but can never touch `role`. Admin can
      // update anything (AdminPanel's edit form).
      allow update: if isAdmin()
        || (isOwner(uid)
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
            && (!('level' in request.resource.data) || (request.resource.data.level is int && request.resource.data.level >= 1))
            && (!('xp' in request.resource.data) || (request.resource.data.xp is int && request.resource.data.xp >= 0))
            && (!('coins' in request.resource.data) || (request.resource.data.coins is int && request.resource.data.coins >= 0))
            && (!('maxStreak' in request.resource.data) || (request.resource.data.maxStreak is int && request.resource.data.maxStreak >= 0))
            && (!('dayStreak' in request.resource.data) || (request.resource.data.dayStreak is int && request.resource.data.dayStreak >= 0))
            && (!('achievementCount' in request.resource.data) || (request.resource.data.achievementCount is int && request.resource.data.achievementCount >= 0 && request.resource.data.achievementCount <= 30)));

      allow delete: if isAdmin();
    }

    match /leaderboards/{categoryKey}/scores/{scoreId} {
      // Leaderboards are shown to signed-out visitors too.
      allow read: if true;

      // Scores are still client-computed (see App.jsx game logic), so this
      // only bounds the damage, it doesn't make scores trustworthy. 10000 is
      // a generous ceiling above the ~5980 max a legitimate 10-question
      // perfect run can produce (10 correct answers at the 20s question
      // timer, streak multiplier up to 2.8x, +10s joker used on the
      // highest-multiplier question).
      //
      // elapsedMs/isPerfect (added for the Rekordi "fastest perfect round"
      // board) are optional - hasOnly bounds which keys CAN exist, it
      // doesn't require them, so older writes without them still validate.
      // 200000ms is the generous ceiling for 10 questions at the 20s timer.
      allow create: if request.resource.data.keys().hasOnly(['name', 'score', 'uid', 'createdAt', 'elapsedMs', 'isPerfect'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 20
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 10000
        && request.resource.data.createdAt == request.time
        && (!('uid' in request.resource.data)
            || request.resource.data.uid == null
            || isOwner(request.resource.data.uid))
        && (!('elapsedMs' in request.resource.data)
            || (request.resource.data.elapsedMs is int
                && request.resource.data.elapsedMs >= 0
                && request.resource.data.elapsedMs <= 200000))
        && (!('isPerfect' in request.resource.data)
            || request.resource.data.isPerfect is bool);

      allow update, delete: if isAdmin();
    }

    // Deliberately public-safe summary for the Rekordi ranking boards
    // (highest level, longest streak, most trophies, longest day-streak) -
    // holds only what a public ranking needs, never the sensitive fields
    // that keep users/{uid} owner/admin-only (email, role, etc.). Synced
    // by syncPublicProfile() alongside the existing full-stats sync.
    match /publicProfiles/{uid} {
      allow read: if true;

      // Admin can also write any uid's doc, specifically so the AdminPanel
      // "backfill" action can populate this collection for existing players
      // who registered before it existed (their doc is otherwise only ever
      // created/updated by their own client, next time they sign back in).
      //
      // achievementCount's ceiling is deliberately well above the 30
      // achievements in src/constants/achievements.js. It used to be exactly
      // 30 - zero headroom - so defining a 31st achievement would have
      // started rejecting every write here, live sync included, with nothing
      // but a swallowed permission error to show for it. Mirrored by
      // MAX_ACHIEVEMENT_COUNT in src/utils/publicProfile.js; keep in sync.
      allow create, update: if (isOwner(uid) || isAdmin())
        && request.resource.data.keys().hasOnly(['displayName', 'level', 'xp', 'maxStreak', 'dayStreak', 'achievementCount', 'updatedAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 20
        && request.resource.data.level is int
        && request.resource.data.level >= 1
        && request.resource.data.xp is int
        && request.resource.data.xp >= 0
        && request.resource.data.maxStreak is int
        && request.resource.data.maxStreak >= 0
        && request.resource.data.dayStreak is int
        && request.resource.data.dayStreak >= 0
        && request.resource.data.achievementCount is int
        && request.resource.data.achievementCount >= 0
        && request.resource.data.achievementCount <= 100;

      allow delete: if isAdmin();
    }

    // Maintained aggregate for the Rekordi "fastest perfect round" board -
    // updated transactionally by maybeUpdateFastestPerfectRecord() whenever
    // a perfect round beats the current top 10, and occasionally rebuilt
    // wholesale by the admin "Rekonstruiraj rekorde" action. Reading this
    // instead of scanning every leaderboards/{cat}/scores subcollection is
    // what keeps Rekordi from being an unbounded read that grows with every
    // score ever saved. Same trust ceiling as leaderboards/{cat}/scores
    // above - client-reported, bounded, not authenticated - since this doc
    // is only ever derived from that same data. Firestore rules can't loop
    // over an arbitrary-length list to validate each entry, so this only
    // bounds the doc's shape/size, not each entry's fields.
    // Admin-only time-tracking instrumentation (beta insights) - one doc per
    // browser session, written by the owning client only. Signed-in users
    // only: anonymous play has no stable identity to correlate across
    // visits, so there's nothing meaningful to tag a session with. The
    // client always writes the FULL current gameStateSeconds snapshot
    // (never deltas/increment()), so there's exactly one writer per doc and
    // no read-modify-write race to worry about here.
    function validSessionShape(data) {
      return data.keys().hasOnly(['uid', 'startedAt', 'lastHeartbeat', 'gameStateSeconds'])
        && data.uid is string
        && data.lastHeartbeat == request.time
        && data.gameStateSeconds is map
        && data.gameStateSeconds.keys().hasOnly(['LOBBY', 'LEADERBOARD', 'PLAYING', 'GAMEOVER', 'VICTORY'])
        && (!('LOBBY' in data.gameStateSeconds) || (data.gameStateSeconds.LOBBY is number && data.gameStateSeconds.LOBBY >= 0 && data.gameStateSeconds.LOBBY <= 86400))
        && (!('LEADERBOARD' in data.gameStateSeconds) || (data.gameStateSeconds.LEADERBOARD is number && data.gameStateSeconds.LEADERBOARD >= 0 && data.gameStateSeconds.LEADERBOARD <= 86400))
        && (!('PLAYING' in data.gameStateSeconds) || (data.gameStateSeconds.PLAYING is number && data.gameStateSeconds.PLAYING >= 0 && data.gameStateSeconds.PLAYING <= 86400))
        && (!('GAMEOVER' in data.gameStateSeconds) || (data.gameStateSeconds.GAMEOVER is number && data.gameStateSeconds.GAMEOVER >= 0 && data.gameStateSeconds.GAMEOVER <= 86400))
        && (!('VICTORY' in data.gameStateSeconds) || (data.gameStateSeconds.VICTORY is number && data.gameStateSeconds.VICTORY >= 0 && data.gameStateSeconds.VICTORY <= 86400));
    }

    match /sessions/{sessionId} {
      allow create: if isOwner(request.resource.data.uid)
        && validSessionShape(request.resource.data)
        && request.resource.data.startedAt == request.time;

      // Owner can only ever heartbeat-update their own session doc, and
      // can't backdate/rewrite when it started.
      allow update: if isOwner(resource.data.uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.startedAt == resource.data.startedAt
        && validSessionShape(request.resource.data);

      allow get: if isOwner(resource.data.uid) || isAdmin();
      allow list: if isAdmin();
      allow delete: if isAdmin();
    }

    // Gameplay content-insights event log (question accuracy, category
    // popularity, win/loss rate - admin dashboard stats, not a per-tester
    // engagement signal). Unlike sessions/{sessionId} above, these accept
    // BOTH anonymous and signed-in play: accuracy/popularity are about
    // content quality, not who's playing, so restricting to signed-in
    // testers would throw away most of the sample. Bounded/validated the
    // same way leaderboards/{cat}/scores already is (client-computed,
    // public, not authenticated - this only bounds the damage). Ceilings
    // below are derived from constants/gameBalance.js: QUESTION_TIME_SECONDS
    // (20) + PLUS_TEN_SECONDS (10) = 30 max timeLeft; MAX_LIVES = 3;
    // QUESTIONS_PER_ROUND = 10; score ceiling matches the leaderboard rule's
    // own derivation above.
    match /questionAttempts/{attemptId} {
      allow create: if request.resource.data.keys().hasOnly(['uid', 'questionId', 'categoryId', 'correct', 'timeLeft', 'livesRemaining', 'createdAt'])
        && request.resource.data.questionId is string
        && request.resource.data.questionId.size() > 0
        && request.resource.data.questionId.size() <= 100
        && request.resource.data.categoryId is string
        && request.resource.data.categoryId.size() > 0
        && request.resource.data.categoryId.size() <= 50
        && request.resource.data.correct is bool
        && request.resource.data.createdAt == request.time
        && (!('uid' in request.resource.data)
            || request.resource.data.uid == null
            || isOwner(request.resource.data.uid))
        && (!('timeLeft' in request.resource.data)
            || (request.resource.data.timeLeft is number && request.resource.data.timeLeft >= 0 && request.resource.data.timeLeft <= 30))
        && (!('livesRemaining' in request.resource.data)
            || (request.resource.data.livesRemaining is int && request.resource.data.livesRemaining >= 0 && request.resource.data.livesRemaining <= 3));

      allow get, list: if isAdmin();
      allow update, delete: if isAdmin();
    }

    match /gameResults/{resultId} {
      allow create: if request.resource.data.keys().hasOnly(['uid', 'outcome', 'category', 'score', 'questionsAnswered', 'correctAnswers', 'durationMs', 'createdAt'])
        && request.resource.data.outcome in ['VICTORY', 'GAMEOVER']
        && request.resource.data.category is string
        && request.resource.data.category.size() > 0
        && request.resource.data.category.size() <= 50
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 10000
        && request.resource.data.createdAt == request.time
        && (!('uid' in request.resource.data)
            || request.resource.data.uid == null
            || isOwner(request.resource.data.uid))
        && (!('questionsAnswered' in request.resource.data)
            || (request.resource.data.questionsAnswered is int && request.resource.data.questionsAnswered >= 0 && request.resource.data.questionsAnswered <= 10))
        && (!('correctAnswers' in request.resource.data)
            || (request.resource.data.correctAnswers is int && request.resource.data.correctAnswers >= 0 && request.resource.data.correctAnswers <= 10))
        && (!('durationMs' in request.resource.data)
            || (request.resource.data.durationMs is int && request.resource.data.durationMs >= 0 && request.resource.data.durationMs <= 300000));

      allow get, list: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // Player-side "report this question" action + admin Reports queue.
    // Public bounded create (anonymous+signed-in), same reasoning as
    // questionAttempts/gameResults above - a bad question is a bad question
    // regardless of who's signed in. Only admin can read the queue or
    // change status (resolve/dismiss); a report can never self-resolve.
    match /reports/{reportId} {
      allow create: if request.resource.data.keys().hasOnly(['uid', 'questionId', 'categoryId', 'reason', 'note', 'status', 'createdAt'])
        && request.resource.data.questionId is string
        && request.resource.data.questionId.size() > 0
        && request.resource.data.questionId.size() <= 100
        && request.resource.data.categoryId is string
        && request.resource.data.categoryId.size() > 0
        && request.resource.data.categoryId.size() <= 50
        && request.resource.data.reason in ['wrong_answer', 'unclear', 'typo', 'offensive', 'other']
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && (!('uid' in request.resource.data)
            || request.resource.data.uid == null
            || isOwner(request.resource.data.uid))
        && (!('note' in request.resource.data)
            || (request.resource.data.note is string && request.resource.data.note.size() <= 500));

      allow get, list: if isAdmin();
      // Resolve/dismiss only - the queue-defining fields can't be rewritten.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['pending', 'resolved', 'dismissed'];
      allow delete: if isAdmin();
    }

    match /records/fastestPerfect {
      allow read: if true;

      allow create, update: if request.resource.data.keys().hasOnly(['entries', 'updatedAt'])
        && request.resource.data.entries is list
        && request.resource.data.entries.size() <= 10;

      allow delete: if isAdmin();
    }

    // Daily Challenge: per-{date,uid} attempt/spend tracking. Mirrors
    // DAILY_CHALLENGE_COSTS = [0, 2, 3, 5] in src/constants/gameBalance.js -
    // keep in sync manually if that table ever changes. Doc id is
    // "{date}_{uid}" (date = Europe/Zagreb YYYY-MM-DD).
    function dailyAttemptCost(attemptsUsedBefore) {
      return attemptsUsedBefore == 0 ? 0
        : attemptsUsedBefore == 1 ? 2
        : attemptsUsedBefore == 2 ? 3
        : attemptsUsedBefore == 3 ? 5
        : 999999999; // unreachable for a valid attempt - forces the cap check below to fail closed
    }

    match /dailyAttempts/{attemptDocId} {
      allow read: if isOwner(resource.data.uid);

      // First attempt of the day for this uid - free, doc doesn't exist yet.
      allow create: if isOwner(request.resource.data.uid)
        && request.resource.data.keys().hasOnly(['uid', 'date', 'attemptsUsed', 'coinsSpentToday', 'updatedAt'])
        && request.resource.data.attemptsUsed == 1
        && request.resource.data.coinsSpentToday == 0
        && request.resource.data.updatedAt == request.time;

      // Attempts 2-4: strictly sequential (+1 each write), hard-capped at 4,
      // and the recorded spend must match the fixed price table for the
      // attempt being purchased. The get() below at least rejects starting a
      // paid attempt with insufficient funds at write time. It does NOT
      // verify the paired users/{uid} coin deduction happens for the exact
      // same amount in the same transaction - Firestore rules evaluate each
      // document's write independently and can't see a sibling document's
      // in-flight write within one transaction, only committed state via
      // get(). That gap is trust-based here, same as every other coin spend
      // in this app today (JOKER_COSTS has zero server-side enforcement) -
      // not a regression, just not a new guarantee either.
      allow update: if isOwner(resource.data.uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.date == resource.data.date
        && request.resource.data.keys().hasOnly(['uid', 'date', 'attemptsUsed', 'coinsSpentToday', 'updatedAt'])
        && request.resource.data.attemptsUsed == resource.data.attemptsUsed + 1
        && request.resource.data.attemptsUsed <= 4
        && request.resource.data.coinsSpentToday == resource.data.coinsSpentToday + dailyAttemptCost(resource.data.attemptsUsed)
        && request.resource.data.updatedAt == request.time
        && get(/databases/$(database)/documents/users/$(resource.data.uid)).data.coins >= dailyAttemptCost(resource.data.attemptsUsed);

      allow delete: if isAdmin();
    }

    // Daily Challenge: one doc per {date,uid} holding only the best score of
    // the day (locked design decision - not one doc per attempt), so the
    // collection is directly queryable by orderBy('score','desc') with no
    // read-time dedup needed. Public read for live standings.
    match /dailyLeaderboards/{date}/scores/{uid} {
      allow read: if true;

      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['uid', 'name', 'score', 'attemptNumber', 'createdAt'])
        && request.resource.data.uid == uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 20
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 10000
        && request.resource.data.attemptNumber is int
        && request.resource.data.attemptNumber >= 1
        && request.resource.data.attemptNumber <= 4
        && request.resource.data.createdAt == request.time
        // The write must correspond to an attempt already recorded in
        // dailyAttempts for this exact date/uid - otherwise nothing stops a
        // client writing straight to the leaderboard, bypassing the
        // attempt/cost tracking above entirely. One get(), keeping the
        // cross-doc read count in this hot path minimal.
        && get(/databases/$(database)/documents/dailyAttempts/$(date + '_' + uid)).data.attemptsUsed >= request.resource.data.attemptNumber
        // Only accept the write if it's the first score of the day or an
        // improvement over the stored best - mirrors
        // maybeUpdateFastestPerfectRecord's "only write if it beats the
        // current record" pattern, enforced here in rules since the doc id
        // is fixed per-uid rather than auto-generated per attempt.
        && (!exists(/databases/$(database)/documents/dailyLeaderboards/$(date)/scores/$(uid))
            || request.resource.data.score >= resource.data.score);

      allow delete: if isAdmin();
    }

    // Daily Challenge: one doc per date, written only by the scheduled
    // payout job (api/daily-challenge-payout.js) via the Firebase Admin SDK,
    // which bypasses these rules entirely - this match block exists only to
    // make client reads possible (e.g. showing "you won yesterday" on next
    // app open) and to explicitly deny any client write, since paying out
    // coins to arbitrary uids must never be something a browser client can
    // trigger itself.
    match /dailyMeta/{date} {
      allow read: if true;
      allow write: if false;
    }
  }
}
